# Minimal image used by runsc-preseed DaemonSet.
# Build context must contain a verified `runsc` binary at ./runsc.
#
#   shasum -a 256 runsc   # must match SandboxConfig / preseed sha256
#   docker build -t {{INTERNAL_REGISTRY}}/gvisor/runsc:20260622 -f Dockerfile.runsc .
#
# Public-safe: no secrets. Use a workplace-approved base image if required.
FROM {{INTERNAL_REGISTRY}}/library/busybox:1.36
COPY runsc /runsc
RUN chmod 0755 /runsc
# Image is only used as an initContainer source; no ENTRYPOINT required.
