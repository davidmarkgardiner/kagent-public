# Minimal image carrying the pinned gVisor runsc binary for the
# runsc-preseed DaemonSet. Nothing is downloaded during the build: the
# binary comes from the build context, which is this folder.
#
# The base image must provide a shell, sha256sum and install, because the
# DaemonSet runs its seed script in this image. Point it at an approved
# internal base.
ARG BASE=busybox:1.36
FROM ${BASE}
COPY runsc /runsc
RUN chmod 0755 /runsc
