apiVersion: v1
kind: ServiceAccount
metadata:
  name: denodo-fastmcp
  namespace: "{{NAMESPACE}}"
  annotations:
    azure.workload.identity/client-id: "{{UAMI_CLIENT_ID}}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: denodo-fastmcp
  namespace: "{{NAMESPACE}}"
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: denodo-fastmcp}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: denodo-fastmcp
        azure.workload.identity/use: "true"
    spec:
      serviceAccountName: denodo-fastmcp
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: fastmcp
          image: "{{DENODO_FASTMCP_IMAGE}}"
          ports: [{name: mcp, containerPort: 8000}]
          env:
            - {name: DENODO_IDENTITY_MODE, value: workload_identity}
            - {name: DENODO_RESOURCE_APP_ID, value: "{{DVP_RESOURCE_APP_ID}}"}
            - {name: DENODO_HOST, value: "{{DVP_HOST}}"}
            - {name: DENODO_PORT, value: "{{DVP_PORT}}"}
            - {name: DENODO_DATABASE, value: "{{DVP_DATABASE}}"}
            - {name: DENODO_APPROVED_VIEW, value: "{{APPROVED_VIEW}}"}
            - {name: DENODO_JDBC_JAR, value: /opt/denodo/denodo-vdp-jdbcdriver.jar}
          resources:
            requests: {cpu: 100m, memory: 384Mi}
            limits: {cpu: 500m, memory: 768Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
            readOnlyRootFilesystem: true
          readinessProbe:
            tcpSocket: {port: mcp}
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: denodo-fastmcp
  namespace: "{{NAMESPACE}}"
spec:
  selector: {app.kubernetes.io/name: denodo-fastmcp}
  ports: [{name: mcp, port: 8000, targetPort: mcp}]
