{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["top_issues", "coverage_gaps"],
  "additionalProperties": false,
  "properties": {
    "top_issues": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["issue", "impact", "evidence_ids", "hypothesis", "confidence", "next_checks", "stabilization", "owner", "recovery_measure"],
        "properties": {
          "issue": {"type": "string", "maxLength": 240},
          "impact": {"type": "string", "maxLength": 512},
          "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
          "hypothesis": {"type": "string", "maxLength": 512},
          "confidence": {"enum": ["high", "medium", "low", "unknown"]},
          "next_checks": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 512}},
          "stabilization": {"type": "string", "maxLength": 1024},
          "owner": {"type": "string", "maxLength": 128},
          "recovery_measure": {"type": "string", "maxLength": 512}
        }
      }
    },
    "coverage_gaps": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 512}}
  }
}
